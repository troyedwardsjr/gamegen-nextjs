{"arguments":{"script":"// Check for console errors and network activity\nconst errors = [];\nconst logs = [];\n\n// Check for any network requests or errors\nconsole.log('Checking for fetch requests and errors...');\n\n// Check for any visible error messages\nconst errorMessages = Array.from(document.querySelectorAll('*')).filter(el => \n  el.textContent && (\n    el.textContent.toLowerCase().includes('error') ||\n    el.textContent.toLowerCase().includes('failed') ||\n    el.textContent.toLowerCase().includes('timeout')\n  )\n);\n\n// Check for any authentication-related issues\nconst authIssues = Array.from(document.querySelectorAll('*')).filter(el => \n  el.textContent && (\n    el.textContent.toLowerCase().includes('login') ||\n    el.textContent.toLowerCase().includes('unauthorized') ||\n    el.textContent.toLowerCase().includes('sign in')\n  )\n);\n\nreturn {\n  errorMessages: errorMessages.map(el => ({\n    tagName: el.tagName,\n    textContent: el.textContent.substring(0, 100)\n  })),\n  authIssues: authIssues.map(el => ({\n    tagName: el.tagName,\n    textContent: el.textContent.substring(0, 100)\n  })),\n  currentUrl: window.location.href,\n  documentReady: document.readyState,\n  timestamp: new Date().toISOString()\n};"},"level":"debug","message":"Tool call received","service":"mcp-puppeteer","timestamp":"2025-09-09 05:14:52.538","tool":"puppeteer_evaluate"}
