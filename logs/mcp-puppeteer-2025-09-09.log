{"arguments":{"script":"// Comprehensive debugging check\nconst debugInfo = {\n  // Check for loading elements\n  loadingElements: Array.from(document.querySelectorAll('*')).map(el => {\n    if (el.textContent && el.textContent.includes('Initializing')) {\n      return {\n        element: el.tagName,\n        className: el.className,\n        text: el.textContent.trim()\n      };\n    }\n  }).filter(Boolean),\n  \n  // Check for any visible error messages\n  errorElements: Array.from(document.querySelectorAll('[class*=\"error\"], [class*=\"Error\"]')).map(el => ({\n    className: el.className,\n    text: el.textContent.trim()\n  })),\n  \n  // Check network requests - look for failed requests\n  performanceEntries: performance.getEntriesByType('navigation').concat(performance.getEntriesByType('resource')).slice(-10).map(entry => ({\n    name: entry.name,\n    type: entry.entryType,\n    status: entry.responseStatus || 'unknown'\n  })),\n  \n  // Check local storage and session storage\n  localStorage: Object.keys(localStorage).reduce((acc, key) => {\n    acc[key] = localStorage.getItem(key)?.substring(0, 100) + '...';\n    return acc;\n  }, {}),\n  \n  // Check if user is authenticated\n  userInfo: localStorage.getItem('supabase.auth.token') ? 'User token exists' : 'No user token',\n  \n  // Check for any React error boundaries\n  reactErrors: window.reactErrors || 'No React errors captured'\n};\n\nreturn debugInfo;"},"level":"debug","message":"Tool call received","service":"mcp-puppeteer","timestamp":"2025-09-09 08:02:42.199","tool":"puppeteer_evaluate"}
