{"arguments":{"script":"() => {\n  // Look for elements with text \"Monthly\" and \"Yearly\"\n  const monthlyElement = Array.from(document.querySelectorAll('*')).find(el => el.textContent?.trim() === 'Monthly');\n  const yearlyElement = Array.from(document.querySelectorAll('*')).find(el => el.textContent?.trim() === 'Yearly');\n  \n  return {\n    monthlyFound: !!monthlyElement,\n    yearlyFound: !!yearlyElement,\n    monthlyClasses: monthlyElement?.className || 'not found',\n    yearlyClasses: yearlyElement?.className || 'not found'\n  };\n}"},"level":"debug","message":"Tool call received","service":"mcp-puppeteer","timestamp":"2025-09-06 05:05:23.299","tool":"puppeteer_evaluate"}
