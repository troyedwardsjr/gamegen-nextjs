{"arguments":{"script":"() => {\n  // Try to find the toggle by looking for the switch element with specific styling\n  const switches = document.querySelectorAll('[class*=\"rounded-full\"]');\n  let found = false;\n  \n  for (let sw of switches) {\n    if (sw.classList.toString().includes('cursor-pointer') && sw.classList.toString().includes('inline-flex')) {\n      // This looks like our toggle\n      found = true;\n      try {\n        sw.click();\n        return { clicked: true, element: sw.className };\n      } catch (e) {\n        return { clicked: false, error: e.message, element: sw.className };\n      }\n    }\n  }\n  \n  return { found: false, totalSwitches: switches.length };\n}"},"level":"debug","message":"Tool call received","service":"mcp-puppeteer","timestamp":"2025-09-06 05:06:08.370","tool":"puppeteer_evaluate"}
