{"arguments":{"script":"() => {\n  // Find the toggle switch and simulate clicking it\n  const toggleSwitches = document.querySelectorAll('div[class*=\"cursor-pointer\"]');\n  if (toggleSwitches.length > 0) {\n    const toggle = toggleSwitches[0];\n    const clickEvent = new MouseEvent('click', {\n      bubbles: true,\n      cancelable: true,\n      view: window\n    });\n    toggle.dispatchEvent(clickEvent);\n    return { success: true, togglesFound: toggleSwitches.length };\n  }\n  return { success: false, togglesFound: 0 };\n}"},"level":"debug","message":"Tool call received","service":"mcp-puppeteer","timestamp":"2025-09-06 05:05:50.098","tool":"puppeteer_evaluate"}
