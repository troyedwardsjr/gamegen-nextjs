{
  "name": "next-app-template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --fix",
    "dev-mode:on": "node scripts/toggle-dev-mode.js on",
    "dev-mode:off": "node scripts/toggle-dev-mode.js off",
    "dev-mode": "node scripts/toggle-dev-mode.js",
    "dev:bypass": "npm run dev-mode:on && npm run dev",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:ci": "NODE_OPTIONS='--experimental-vm-modules' jest --ci --coverage --watchAll=false --passWithNoTests",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest --testPathPattern='__tests__/(components|lib|hooks|utils)/'",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules' jest --testPathPattern='__tests__/integration/'",
    "test:api": "NODE_OPTIONS='--experimental-vm-modules' jest --testPathPattern='__tests__/api/'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:mobile": "playwright test mobile-experience-flow.spec.ts",
    "test:e2e:desktop": "playwright test --project='chromium' --project='firefox' --project='webkit'",
    "test:e2e:registration": "playwright test user-registration-flow.spec.ts",
    "test:e2e:login": "playwright test user-login-flow.spec.ts",
    "test:e2e:pricing": "playwright test pricing-subscription-flow.spec.ts",
    "test:e2e:errors": "playwright test error-handling-edge-cases.spec.ts",
    "test:e2e:performance": "playwright test performance-accessibility.spec.ts",
    "test:e2e:dev": "npm run dev-mode:on && playwright test",
    "test:all": "npm run test:ci && npm run test:e2e",
    "playwright:install": "playwright install",
    "playwright:install-deps": "playwright install-deps",
    "tauri:dev": "tauri dev",
    "tauri:build": "TAURI_BUILD=true npm run build && tauri build",
    "tauri:build:debug": "TAURI_BUILD=true npm run build && tauri build --debug",
    "tauri:build:windows": "TAURI_BUILD=true npm run build && tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:macos": "TAURI_BUILD=true npm run build && tauri build --target x86_64-apple-darwin",
    "tauri:build:macos:arm": "TAURI_BUILD=true npm run build && tauri build --target aarch64-apple-darwin",
    "tauri:build:linux": "TAURI_BUILD=true npm run build && tauri build --target x86_64-unknown-linux-gnu",
    "tauri:build:all": "npm run tauri:build:windows && npm run tauri:build:macos && npm run tauri:build:macos:arm && npm run tauri:build:linux",
    "desktop:dev": "npm run tauri:dev",
    "desktop:build": "npm run tauri:build",
    "desktop:setup": "cd src-tauri && cargo install tauri-cli"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.61.0",
    "@heroui/avatar": "^2.2.21",
    "@heroui/badge": "^2.2.16",
    "@heroui/button": "2.2.25",
    "@heroui/card": "^2.2.24",
    "@heroui/checkbox": "^2.3.25",
    "@heroui/chip": "^2.2.21",
    "@heroui/code": "2.2.19",
    "@heroui/divider": "^2.2.18",
    "@heroui/dropdown": "^2.3.25",
    "@heroui/input": "2.4.26",
    "@heroui/kbd": "2.2.20",
    "@heroui/link": "2.2.22",
    "@heroui/listbox": "2.3.24",
    "@heroui/modal": "^2.2.22",
    "@heroui/navbar": "2.2.23",
    "@heroui/progress": "^2.2.21",
    "@heroui/select": "^2.4.26",
    "@heroui/snippet": "2.2.26",
    "@heroui/spinner": "^2.2.22",
    "@heroui/switch": "2.2.23",
    "@heroui/system": "2.4.21",
    "@heroui/tabs": "^2.2.22",
    "@heroui/theme": "2.4.21",
    "@heroui/tooltip": "^2.2.22",
    "@react-aria/ssr": "3.9.10",
    "@react-aria/visually-hidden": "3.8.27",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "clsx": "2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "11.18.2",
    "intl-messageformat": "10.7.16",
    "lucide-react": "^0.542.0",
    "next": "15.3.1",
    "next-themes": "0.4.6",
    "p-queue": "^8.1.0",
    "p-retry": "^7.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^2.1.0",
    "react-window-infinite-loader": "^1.0.10",
    "recharts": "^3.1.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/compat": "^1.3.2",
    "@next/eslint-plugin-next": "15.3.4",
    "@playwright/test": "^1.55.0",
    "@react-types/shared": "3.30.0",
    "@tailwindcss/postcss": "4.1.11",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "20.5.7",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/react-syntax-highlighter": "^15.5.11",
    "@types/react-virtualized-auto-sizer": "^1.0.4",
    "@types/react-window": "^1.8.8",
    "@types/react-window-infinite-loader": "^1.0.9",
    "@typescript-eslint/eslint-plugin": "8.34.1",
    "@typescript-eslint/parser": "8.34.1",
    "artillery": "^2.0.24",
    "dotenv": "^17.2.2",
    "eslint": "9.25.1",
    "eslint-config-next": "15.3.4",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-unused-imports": "4.1.4",
    "globals": "16.0.0",
    "jest": "^30.1.3",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.1.2",
    "lighthouse-ci": "^1.13.1",
    "msw": "^2.11.1",
    "postcss": "8.5.6",
    "prettier": "3.5.3",
    "tailwind-variants": "3.1.0",
    "tailwindcss": "4.1.11",
    "typescript": "5.6.3"
  }
}
