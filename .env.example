# Supabase Configuration
# These are placeholder values - replace with your actual Supabase project credentials

# Pixellab API key
PIXELLAB_API_KEY=your-api-key-here

# Supabase Project URL (found in your Supabase project settings)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Key (found in your Supabase project settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (found in your Supabase project settings -> API)
# This is used for admin operations and should be kept secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase access token for migrations and stuff
SUPABASE_ACCESS_TOKEN=your-supabase-access-token-here

# Database URL for direct connections (optional, for advanced use cases)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Database Connection Pool Configuration
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_ACQUIRE_TIMEOUT=60000

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# Environment
NODE_ENV=development

# AI Provider Configuration
# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
# Optional: Custom OpenAI base URL (for enterprise or proxy)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# Optional: Custom Anthropic base URL
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ElevenLabs API Configuration (existing)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# OpenAI API key
OPENAI_API_KEY=

# AI Service Configuration
# Mock provider error rate for testing (0.0 to 1.0, default: 0)
MOCK_ERROR_RATE=0

# Rate limiting and cost tracking are configured in code
# but depend on the environment variables above

# Stripe Configuration (for subscription management)
# Get these from your Stripe Dashboard -> Developers -> API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here

# Stripe Webhook Configuration
# Create a webhook endpoint in your Stripe Dashboard -> Developers -> Webhooks
# Point it to: https://yourdomain.com/api/stripe/webhooks
# Select these events: customer.subscription.*, invoice.payment_*, payment_method.*
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Authentication & Security Configuration
# Site URL for OAuth redirects and email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CSRF Protection Secret (generate with: openssl rand -base64 32)
CSRF_SECRET=your-csrf-secret-key-here

# Cookie Domain (set to your domain in production, e.g., ".gamegen.com")
COOKIE_DOMAIN=localhost

# OAuth Provider Configuration
# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Discord OAuth (get from Discord Developer Portal)
DISCORD_CLIENT_ID=your-discord-oauth-client-id
DISCORD_CLIENT_SECRET=your-discord-oauth-client-secret

# GitHub OAuth (get from GitHub Settings -> Developer settings)
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Apple OAuth (get from Apple Developer Console)
APPLE_CLIENT_ID=your-apple-oauth-client-id
APPLE_PRIVATE_KEY_ID=your-apple-private-key-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
your-apple-private-key-content-here
-----END PRIVATE KEY-----"

# Email Configuration (for transactional emails)
# You can use Supabase's built-in email service or configure your own SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
FROM_EMAIL=noreply@gamegen.com
FROM_NAME="GameGen Platform"

# Redis Configuration (for rate limiting and caching in production)
# For development, the system uses in-memory storage
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# Security Headers Configuration
# Enable strict transport security in production
ENABLE_HSTS=true

# Logging and Monitoring
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Enable security event logging
ENABLE_SECURITY_LOGGING=true

# Webhook URL for critical security alerts (optional)
SECURITY_WEBHOOK_URL=https://hooks.slack.com/your-webhook-url
