# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=your-apple-private-key

# Security Configuration
CSRF_SECRET=generate-a-random-32-char-string
JWT_SECRET=generate-a-random-32-char-string
REFRESH_TOKEN_SECRET=generate-a-random-32-char-string

# Email Configuration (for verification)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@gamegen.com

# Rate Limiting (Redis)
REDIS_URL=redis://localhost:6379

# Session Configuration
SESSION_SECRET=generate-a-random-32-char-string
SESSION_MAX_AGE=2592000 # 30 days in seconds

# Cookie Configuration
COOKIE_DOMAIN=.gamegen.com
COOKIE_SECURE=true # Set to false in development
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=strict

# MFA Configuration
MFA_APP_NAME="GameGen Platform"
MFA_ISSUER="gamegen.com"

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Feature Flags
ENABLE_MFA=true
ENABLE_SOCIAL_AUTH=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_RATE_LIMITING=true

# Development
NODE_ENV=development
